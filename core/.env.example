# ── Jagaimo core — environment template ──────────────────────────────────────
# Copy to `core/.env`, fill in, then:  chmod 600 core/.env
# `.env` is gitignored. Never commit real secrets.

# Postgres (self-hosted Supabase) — least-privilege "ingester" role, tracking schema.
DATABASE_URL=postgresql://ingester:password@127.0.0.1:5432/postgres

# Alpaca (read-only positions + clock/calendar). OPTIONAL — omit to skip equities.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://api.alpaca.markets   # paper: https://paper-api.alpaca.markets

# EVM / Base. Primary path: Alchemy (token discovery + metadata + spam flag).
ALCHEMY_API_KEY=
# Fallback path: public RPC + an explicit allowlist (comma-separated contract addrs).
BASE_RPC_URL=
TOKEN_ALLOWLIST=

# Wallet addresses (public; read-only).
WALLET_STANDARD_ADDRESS=
WALLET_01_ADDRESS=

# CoinGecko (free tier; demo key optional). Set COINGECKO_PRO=true if using a pro key.
COINGECKO_API_KEY=
COINGECKO_PRO=false

# Telegram alerts (OPTIONAL — omit to disable notifications).
TELEGRAM_BOT_TOKEN=
TELEGRAM_LOG_CHAT_ID=
TELEGRAM_ALERT_CHAT_ID=

# Net-worth alert thresholds (tunable; defaults shown).
NETWORTH_ALERT_PCT=5.0
NETWORTH_ALERT_USD=25.0
NETWORTH_ALERT_COOLDOWN_MIN=60
