# Jagaimo viewer — static site served over the tailnet only (V9).
# Bind explicitly to the host's Tailscale IP so the viewer is never exposed on a
# public interface. Access control IS the tailnet ACL — there is no app auth
# (single user, decision §2.11). RLS still constrains the anon key server-side.
#
# Replace 100.x.y.z with this host's `tailscale ip -4`.

{
    admin off
    auto_https off
}

http://100.x.y.z:8080 {
    root * /opt/jagaimo/viewer/dist
    encode gzip
    # SPA fallback so client-side state survives a refresh.
    try_files {path} /index.html
    file_server
}
